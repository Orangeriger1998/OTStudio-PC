{
  "name": "otstudio-pc",
  "productName": "OT Studio",
  "version": "0.2.0",
  "description": "Pictures and videos from your own API keys, on Windows.",
  "author": "OrangeTiger",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.orangetiger.otstudio.pc",
    "productName": "OT Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OT Studio"
    },
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "electron@44.7.0": true,
    "ffmpeg-static@5.3.0": true
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5"
  }
}
